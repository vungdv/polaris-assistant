{
  "realm": "polaris",
  "enabled": true,
  "clients": [
    {
      "clientId": "polaris-app",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "https://polaris.local/swagger-ui/index.html",
        "https://polaris.local/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": ["https://polaris.local"],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid", "basic", "profile", "email", "roles", "web-origins"
      ]
    },
    {
      "clientId": "polaris-local",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:8080/swagger-ui/index.html",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": ["http://localhost:8080"],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid", "basic", "profile", "email", "roles", "web-origins"
      ]
    },
    {
      "clientId": "polaris-mcp",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://127.0.0.1:*",
        "http://localhost:*",
        "http://127.0.0.1:8085/oauth/callback",
        "http://localhost:8085/oauth/callback"
      ],
      "webOrigins": ["+"],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "openid", "basic", "profile", "email", "roles", "web-origins"
      ]
    },
    {
      "clientId": "polaris-api",
      "name": "Polaris Resource Server",
      "description": "Holds fine-grained permissions (client roles) consumed by the catalog/order/customer/inventory APIs. Not used for login.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "polaris-fulfilment-emulator",
      "name": "Polaris Fulfilment Emulator",
      "description": "Machine client (client-credentials) used by the fulfilment emulator to claim orders.",
      "enabled": true,
      "publicClient": false,
      "secret": "${POLARIS_FULFILMENT_EMULATOR_SECRET}",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid", "basic", "profile", "email", "roles", "web-origins"
      ]
    }
  ],

  "roles": {
    "realm": [
      { "name": "admin", "description": "Administrator with full system privileges",
        "composite": true,
        "composites": { "client": { "polaris-api": [
          "catalog.read", "catalog.write",
          "order.read", "order.write",
          "customer.read", "customer.write",
          "inventory.read", "inventory.write"
        ]}}
      },

      { "name": "customer-success", "description": "Customer Success - managing customer profiles, accounts, and relationships",
        "composite": true,
        "composites": { "client": { "polaris-api": ["customer.read", "customer.write"] }}
      },
      { "name": "customer_success", "description": "Customer Success alias (snake_case)",
        "composite": true,
        "composites": { "client": { "polaris-api": ["customer.read", "customer.write"] }}
      },

      { "name": "product-catalog", "description": "Product Catalog - managing product information, pricing, categories, and catalog hierarchy",
        "composite": true,
        "composites": { "client": { "polaris-api": ["catalog.read", "catalog.write"] }}
      },
      { "name": "product_catalog", "description": "Product Catalog alias (snake_case)",
        "composite": true,
        "composites": { "client": { "polaris-api": ["catalog.read", "catalog.write"] }}
      },

      { "name": "inventory", "description": "Inventory - managing store stock, warehouses, and product quantity sync",
        "composite": true,
        "composites": { "client": { "polaris-api": ["inventory.read", "inventory.write"] }}
      },

      { "name": "purchase-management", "description": "Purchase Management - handling customer purchases, orders, and fulfillment",
        "composite": true,
        "composites": { "client": { "polaris-api": ["order.read", "order.write"] }}
      },
      { "name": "purchase_management", "description": "Purchase Management alias (snake_case)",
        "composite": true,
        "composites": { "client": { "polaris-api": ["order.read", "order.write"] }}
      },
      { "name": "shopper", "description": "Self-service shopper: browses the catalog and places orders for their own linked customer account only",
        "composite": true,
        "composites": { "client": { "polaris-api": ["catalog.read", "order.read", "order.write"] }}
      }
    ],
    "client": {
      "polaris-api": [
        { "name": "catalog.read", "description": "Read access to the product catalog — search products and look up SKUs" },
        { "name": "catalog.write", "description": "Write access to the product catalog — manage products and categories" },
        { "name": "order.read", "description": "Read access to orders — status checks, full details, and order history" },
        { "name": "order.write", "description": "Write access to orders — place new orders and cancel existing ones" },
        { "name": "order.fulfil", "description": "Fulfilment access to orders — claim a placed order on behalf of a fulfilment partner" },
        { "name": "customer.read", "description": "Read access to customer profiles and account information" },
        { "name": "customer.write", "description": "Write access to customer profiles — update customer details and accounts" },
        { "name": "inventory.read", "description": "Read access to store inventory, stock levels, and warehouse counts" },
        { "name": "inventory.write", "description": "Write access to store inventory — adjust stock and sync product counts" }
      ]
    }
  },

