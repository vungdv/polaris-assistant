{
  "uid": "polaris-ai-observability",
  "title": "AI Observability",
  "tags": [
    "genai",
    "ai-observability",
    "polaris"
  ],
  "description": "OTel GenAI semconv analytics (gen_ai.client.* metrics from the agento11y SDK), mirroring Grafana Cloud AI Observability > Analytics.",
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name!=\"execute_tool\"}, gen_ai_agent_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name!=\"execute_tool\"}, gen_ai_agent_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name!=\"execute_tool\", gen_ai_agent_name=~\"$agent\"}, gen_ai_request_model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name!=\"execute_tool\", gen_ai_agent_name=~\"$agent\"}, gen_ai_request_model)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "quantile",
        "label": "Latency",
        "type": "custom",
        "query": "P50 : 0.5,P95 : 0.95,P99 : 0.99",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "P95",
          "value": "0.95"
        },
        "options": [
          {
            "text": "P50",
            "value": "0.5",
            "selected": false
          },
          {
            "text": "P95",
            "value": "0.95",
            "selected": true
          },
          {
            "text": "P99",
            "value": "0.99",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Total Requests",
      "description": "Model generations in the time range (tool executions excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name!=\"execute_tool\", gen_ai_agent_name=~\"$agent\", gen_ai_request_model=~\"$model\"}[$__range]))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
