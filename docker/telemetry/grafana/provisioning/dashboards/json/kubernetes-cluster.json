    },
    {
      "type": "timeseries",
      "id": 27,
      "title": "Pod network traffic by namespace",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace) (rate(container_network_receive_bytes_total{namespace=~\"$namespace\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{namespace}} rx"
        },
        {
          "datasource": {
            "type": "prometheus",
