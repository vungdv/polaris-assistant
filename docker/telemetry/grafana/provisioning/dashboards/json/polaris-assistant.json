{
  "uid": "polaris-assistant",
  "title": "Polaris Assistant",
  "tags": [
    "polaris",
    "assistant",
    "slo",
    "agent"
  ],
  "description": "Polaris-Assistant SLOs per endpoint (availability, latency, error budget, burn rate), per-endpoint response times, and agent outcomes (order conversion, abandonment, turn success).",
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "quantile",
        "label": "Latency",
        "type": "custom",
        "query": "P50 : 0.5,P95 : 0.95,P99 : 0.99",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "P95",
          "value": "0.95"
        },
        "options": [
          {
            "text": "P50",
            "value": "0.5",
            "selected": false
          },
          {
            "text": "P95",
            "value": "0.95",
            "selected": true
          },
          {
            "text": "P99",
            "value": "0.99",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "SLOs (rules/assistant-slo.rules.yml)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "SLI over time range",
      "description": "Good requests / all requests in the time range, per endpoint and SLI. availability: non-5xx. latency: chat <= 30 s, draft-decision (confirm/cancel) <= 2 s. Targets: chat 99 % / 95 %, draft-decision 99.5 % / 99 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum by (endpoint, sli) (sum_over_time(sli:bad_requests:rate5m{service=\"polaris-assistant\"}[$__range])) / sum by (endpoint, sli) (sum_over_time(sli:requests:rate5m{service=\"polaris-assistant\"}[$__range])))",
          "refId": "A",
          "legendFormat": "{{endpoint}} {{sli}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "\u2013"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Error budget remaining",
      "description": "1 - (error ratio in the time range / error budget). Below 0 the SLO is missed for this range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum by (endpoint, sli) (sum_over_time(sli:bad_requests:rate5m{service=\"polaris-assistant\"}[$__range])) / sum by (endpoint, sli) (sum_over_time(sli:requests:rate5m{service=\"polaris-assistant\"}[$__range]))) / on (endpoint, sli) group_left sum by (endpoint, sli) (sli:error_budget:ratio{service=\"polaris-assistant\"}))",
          "refId": "A",
          "legendFormat": "{{endpoint}} {{sli}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "\u2013"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      }
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Burn rate (1h window)",
      "description": "Error ratio over the last hour / error budget. 1 = spending the budget exactly over 30 days. AssistantSloBurnFast pages above 14.4 (with the 5m window), AssistantSloBurnMedium above 6 (6h and 30m).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sli:error_ratio:window{service=\"polaris-assistant\", window=\"1h\"} / on (service, endpoint, sli) group_left sli:error_budget:ratio",
          "refId": "A",
          "legendFormat": "{{endpoint}} {{sli}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 5,
      "title": "Endpoints (http.server.requests)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
    {
      "type": "table",
      "id": 6,
      "title": "Endpoints over time range",
      "description": "Per endpoint: requests, latency percentiles (interpolated within the explicit buckets 100ms..60s) and the 5xx ratio. Actuator endpoints excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, uri) (increase(http_server_requests_milliseconds_count{exported_job=\"Polaris-Assistant\", uri!~\"/actuator.*\"}[$__range]))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, method, uri) (increase(http_server_requests_milliseconds_bucket{exported_job=\"Polaris-Assistant\", uri!~\"/actuator.*\"}[$__range])))",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (increase(http_server_requests_milliseconds_bucket{exported_job=\"Polaris-Assistant\", uri!~\"/actuator.*\"}[$__range])))",
          "refId": "C",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, method, uri) (increase(http_server_requests_milliseconds_bucket{exported_job=\"Polaris-Assistant\", uri!~\"/actuator.*\"}[$__range])))",
          "refId": "D",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (method, uri) (increase(http_server_requests_milliseconds_count{exported_job=\"Polaris-Assistant\", uri!~\"/actuator.*\", status=~\"5..\"}[$__range])) or sum by (method, uri) (increase(http_server_requests_milliseconds_count{exported_job=\"Polaris-Assistant\", uri!~\"/actuator.*\"}[$__range])) * 0) / sum by (method, uri) (increase(http_server_requests_milliseconds_count{exported_job=\"Polaris-Assistant\", uri!~\"/actuator.*\"}[$__range]))",
          "refId": "E",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "method": 0,
              "uri": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6
            },
            "renameByName": {
              "method": "Method",
              "uri": "Endpoint",
              "Value #A": "Requests",
              "Value #B": "p50",
              "Value #C": "p95",
              "Value #D": "p99",
              "Value #E": "5xx ratio"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx ratio"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Latency ${quantile:text} by endpoint",
      "description": "Interpolated within the explicit buckets (100ms..60s).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile($quantile, sum by (le, method, uri) (rate(http_server_requests_milliseconds_bucket{exported_job=\"Polaris-Assistant\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Requests/s by endpoint and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, uri, status) (rate(http_server_requests_milliseconds_count{exported_job=\"Polaris-Assistant\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 9,
      "title": "Agent outcomes (polaris.assistant.*)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 10,
      "title": "Order conversion",
      "description": "Drafts that became an order / drafts decided in the time range (superseded drafts are replaced by a newer one, so they are not a decision).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(polaris_assistant_draft_lifetime_milliseconds_count{exported_job=\"Polaris-Assistant\", outcome=~\"placed\"}[$__range])) or vector(0)) / sum(increase(polaris_assistant_draft_lifetime_milliseconds_count{exported_job=\"Polaris-Assistant\", outcome!=\"superseded\"}[$__range]))",
          "refId": "A",
          "legendFormat": "placed",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "\u2013"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Declined",
      "description": "Cancelled by the shopper or discarded by the agent on request: a clear 'no', not a failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(polaris_assistant_draft_lifetime_milliseconds_count{exported_job=\"Polaris-Assistant\", outcome=~\"cancelled|discarded\"}[$__range])) or vector(0)) / sum(increase(polaris_assistant_draft_lifetime_milliseconds_count{exported_job=\"Polaris-Assistant\", outcome!=\"superseded\"}[$__range]))",
          "refId": "A",
          "legendFormat": "declined",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
