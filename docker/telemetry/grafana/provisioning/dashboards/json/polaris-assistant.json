      }
    },
    {
      "type": "stat",
      "id": 13,
      "title": "Failed (invalidated)",
      "description": "Order Management rejected the draft at confirmation: price changed, out of stock, product inactive.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(polaris_assistant_draft_lifetime_milliseconds_count{exported_job=\"Polaris-Assistant\", outcome=~\"invalidated\"}[$__range])) or vector(0)) / sum(increase(polaris_assistant_draft_lifetime_milliseconds_count{exported_job=\"Polaris-Assistant\", outcome!=\"superseded\"}[$__range]))",
