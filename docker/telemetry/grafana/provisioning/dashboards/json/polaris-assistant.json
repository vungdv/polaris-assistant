        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "id": 12,
      "title": "Abandoned (expired)",
      "description": "The 15-minute price hold elapsed with no decision.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(polaris_assistant_draft_lifetime_milliseconds_count{exported_job=\"Polaris-Assistant\", outcome=~\"expired\"}[$__range])) or vector(0)) / sum(increase(polaris_assistant_draft_lifetime_milliseconds_count{exported_job=\"Polaris-Assistant\", outcome!=\"superseded\"}[$__range]))",
          "refId": "A",
          "legendFormat": "expired",
