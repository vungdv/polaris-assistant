{
  "mermaid-validator": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/validate-mermaid.mjs --hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
