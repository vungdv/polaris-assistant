# Pinned tool and cluster versions for the Kubernetes deployment (ADR-0021, TR-K2).
# Sourced by scripts/k8s/*.sh and the k8s CI workflow. Bump here only; nothing else hardcodes a version.

# kind CLI and its node image (digest from the kind release notes for this kind version)
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# Kubernetes version of the node image: kubectl (client skew +-1) and kubeconform schemas follow it
KUBERNETES_VERSION=1.37.0
KUBECTL_VERSION=v1.37.0

# Manifest validation: kubeconform, the Kubernetes JSON schemas it reads (yannh/kubernetes-json-schema) and the
# datreeio CRDs catalog for custom resources, both pinned to a commit
KUBECONFORM_VERSION=v0.8.0
K8S_SCHEMAS_REF=8df8a883b68a24a104b4a9e43c1288090ae60b3b
CRDS_CATALOG_REF=4c8dc296d32b06d15ccde9668ff136c951f4d539

# Helm CLI: installs the platform components below from their upstream charts (TR-K1)
HELM_VERSION=v4.3.0

# Edge (K3). Charts are pulled from the upstream OCI registries at these versions; nothing is copied into the repo.
# Gateway API CRDs: the standard channel at the version NGINX Gateway Fabric is built against (its go.mod and
# config/crd/gateway-api), installed from the upstream release asset and verified against this SHA-256.
CERT_MANAGER_CHART=oci://quay.io/jetstack/charts/cert-manager
CERT_MANAGER_VERSION=v1.21.2
TRUST_MANAGER_CHART=oci://quay.io/jetstack/charts/trust-manager
TRUST_MANAGER_VERSION=v0.25.0
NGF_CHART=oci://ghcr.io/nginx/charts/nginx-gateway-fabric
NGF_VERSION=2.7.2
GATEWAY_API_VERSION=v1.6.1
GATEWAY_API_CRDS_SHA256=24d931f22abd8e40c973264319ead7cfa09d0fb7716b7ab1ee2ff174cb063a73

# Observability (K4): the upstream OpenTelemetry Collector chart, for both the Collector (Deployment) and the log agent
# (DaemonSet). Its image is the contrib distribution at the chart's appVersion, so this pin also pins the image.
OTEL_COLLECTOR_CHART=oci://ghcr.io/open-telemetry/opentelemetry-helm-charts/opentelemetry-collector
OTEL_COLLECTOR_VERSION=0.175.1

# Data stores (K5): the CloudNativePG operator from its upstream chart (chart 0.28.3 = operator 1.29.1, the latest 1.29
# patch). The minor is held at the CNPG version whose Cluster schema the pinned CRDs catalog (CRDS_CATALOG_REF) carries:
# its postgresql.cnpg.io/cluster_v1.json is identical to this chart's Cluster CRD, so kubeconform validates the Cluster
# CRs against the schema of the operator that runs them (the catalog has no 1.30 schema yet). Bump both together.
# The PostgreSQL and Redis images are pinned by digest in deploy/k8s/base/data and deploy/k8s/base/redis.
CNPG_CHART=oci://ghcr.io/cloudnative-pg/charts/cloudnative-pg
CNPG_VERSION=0.28.3

# Kafka (K6, D3): the Strimzi cluster operator from its upstream chart (chart version = operator version; the operator
# image and the Kafka images it runs are quay.io/strimzi/*:<this version>, so this pin also pins them). Held at 0.49.1,
# the Strimzi release whose CRDs the pinned CRDs catalog (CRDS_CATALOG_REF) was generated from: its
# kafka.strimzi.io/kafka_v1.json and kafkanodepool_v1.json are identical to this chart's Kafka and KafkaNodePool CRDs, so
# kubeconform validates the CRs against the schema of the operator that runs them. 0.50 and later add fields the catalog
# doesn't have yet (pod template hostUsers, listener and rack fields in 1.x). Bump both together.
# Strimzi 0.49 runs Kafka 4.0.x and 4.1.x only (3.9 support ended in 0.48), so the cluster runs Kafka 4.1.1
# (spec.kafka.version in deploy/k8s/base/kafka/kafka.yaml), as Compose runs apache/kafka:4.1.1.
STRIMZI_CHART=oci://quay.io/strimzi-helm/strimzi-kafka-operator
STRIMZI_VERSION=0.49.1

# Client image for the in-cluster smoke checks (curl, runs as non-root UID 100)
SMOKE_CURL_IMAGE=curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
# k6 for the in-cluster run of tests/perf/api-test.js (K8), the image `make test-perf` runs, pinned by its multi-arch
# index digest (runs as non-root UID 12345)
SMOKE_K6_IMAGE=grafana/k6:2.2.0@sha256:9bd01d6941fca969cb61bb57d2da5ee9b385fe2aa8881df3798c196564d6ace6

# Identity (K7, D4): the Keycloak Operator from its upstream release manifests (keycloak/keycloak-k8s-resources at this
# tag: the two CRDs and kubernetes/kubernetes.yml), downloaded by scripts/k8s/platform.sh and verified against these
# SHA-256s, never copied into the repo. The operator version is the Keycloak version; 26.2.5 is the last patch of the
# 26.2 line that Compose runs (quay.io/keycloak/keycloak:26.2). The server image is pinned by digest in
# deploy/k8s/base/keycloak/keycloak.yaml; bump both together.
# Validation: the pinned CRDs catalog (CRDS_CATALOG_REF) has k8s.keycloak.org keycloak_v2alpha1.json and
# keycloakrealmimport_v2alpha1.json from a newer Keycloak (26.6). Their spec is a strict superset of 26.2.5's CRDs
# (every 26.2.5 field exists there with the same type; newer ones such as spec.env, spec.telemetry and spec.import are
# added), so kubeconform accepts every valid 26.2.5 CR but would not flag a newer-only field. The API server catches
# that: `kubectl apply` validates the CRs strictly against the installed 26.2.5 CRDs on every `make k8s-up`.
KEYCLOAK_VERSION=26.2.5
KEYCLOAK_CRD_SHA256=f9a775372d47c5d877e36f1da8602ee0a7a3b46c6dcfde07b9958275c85080ee
KEYCLOAK_REALM_IMPORT_CRD_SHA256=5d25c702ab65e72f5a2b9421831cac2c147ef75bc0b1864e790eb5de4b3e8e43
KEYCLOAK_OPERATOR_SHA256=a5de751c353a7f74b735fdb08ccde19b2cbd503d239622a2cab9cfdd5cc39827

# Hardening (K11).
# metrics-server, the source of the CPU metrics the HorizontalPodAutoscalers read, from its upstream chart (not published
# as OCI; pulled from the chart repository at this version). The image tag is the chart's appVersion.
METRICS_SERVER_REPO=https://kubernetes-sigs.github.io/metrics-server/
METRICS_SERVER_CHART=metrics-server
METRICS_SERVER_VERSION=3.14.0
# CNPG backups (D2): the Barman Cloud plugin (CNPG-I), the upstream replacement for CNPG's in-tree barmanObjectStore
# (the `standard` PostgreSQL images carry no barman-cloud; the plugin injects its own sidecar). Chart 0.8.1 = plugin
# v0.15.1, which supports CloudNativePG 1.26 and later. The plugin and sidecar images are tagged with the appVersion.
BARMAN_CLOUD_CHART=oci://ghcr.io/cloudnative-pg/charts/plugin-barman-cloud
BARMAN_CLOUD_VERSION=0.8.1
# The in-cluster S3-compatible object store the backups go to: SeaweedFS in its all-in-one mode (master, volume, filer
# and S3 gateway in one pod), from its upstream chart repository. The image tag is the chart's appVersion.
SEAWEEDFS_REPO=https://seaweedfs.github.io/seaweedfs/helm
SEAWEEDFS_CHART=seaweedfs
SEAWEEDFS_VERSION=4.48.0
