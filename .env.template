POLARIS_DOMAIN=polaris.local
GEMINI_API_KEY=
TYPESAFE_API_KEY=
DEFAULT_PASSWORD=
# Grafana Cloud OTLP export (stack https://sincerelorry365.grafana.net/):
# portal -> stack -> OpenTelemetry -> Configure (endpoint, instance ID, token with metrics/logs/traces:write)
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-<zone>.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
# Grafana AI Observability generation export (prompt/response records for the Conversations view).
# Leave AGENTO11Y_PROTOCOL=none for local-only analytics. For Grafana Cloud: portal -> stack -> AI Observability
# -> Configure (endpoint, tenant/instance ID, token); this is a different credential from the OTLP token above.
AGENTO11Y_PROTOCOL=none
AGENTO11Y_ENDPOINT=
# Set to basic together with the endpoint, tenant ID and token; blank keeps auth off.
AGENTO11Y_AUTH_MODE=
AGENTO11Y_AUTH_TENANT_ID=
AGENTO11Y_AUTH_TOKEN=
